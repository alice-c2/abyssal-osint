# Copy this file to `.env` and fill in your real keys.
# .env is gitignored — these never get committed or sent to the browser.
# The backend uses them for every visitor, so nobody else needs their own key.
# Alice AI doesn't need a key here — it's a self-contained rule engine.

SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
STEAM_API_KEY=
OATHNET_API_KEY=
# Get a key from the dashboard at socialcrawl.dev. Auth is the `x-api-key`
# header. Powers the Socials module (Instagram, LinkedIn, Facebook, etc.).
SOCIALCRAWL_API_KEY=
# Get this by logging into playstation.com then visiting
# https://ca.account.sony.com/api/v1/ssocookie — copy the "npsso" value.
# Expires after ~2 months, just repeat the steps to get a new one.
PSN_NPSSO=
# Free key from fortnite-api.com/dashboard — only needed for /v2/stats
# (their news/cosmetics endpoints are keyless, stats requires one).
FORTNITE_API_KEY=
# TikTok needs no key — it scrapes the profile page's own embedded JSON.
# Free key from numverify.com/product (apilayer) — free tier is http:// only.
NUMVERIFY_API_KEY=
# Indicia (indicia.app) — mint a scoped key per module from your dashboard.
# Only INDICIA_HUDSONROCK_KEY is required for Hudson Rock search; the
# account needs credits for it to return anything. The same key also
# powers Discord's public connectedAccounts lookup.
INDICIA_HUDSONROCK_KEY=
# Free bot token from discord.com/developers (New Application > Bot >
# Reset Token). Only used for GET /users/{id} — public_flags/accent_color,
# nothing that needs the bot in a server.
DISCORD_BOT_TOKEN=
# URL of a Netryx Astra V2 instance (github.com/sparkyniner/Netryx-Astra-V2-
# Geolocation-Tool) exposing POST /geolocate. This is a local ML pipeline
# (needs GPU + multi-GB indexes), not a hosted API — deploy it yourself
# somewhere with a GPU, wrap it with an HTTP handler, then point this at it.
# e.g. https://your-netryx-host:8001 — leave empty to disable the module.
NETRYX_ASTRA_URL=
# Truecaller owner-name lookup via truecallerjs (github.com/sumithemmadi/
# truecallerjs, installed in backend/truecaller_cli/). Not an API key —
# it's an installationId from actually registering a Truecaller account.
# Get it by running (needs a real phone number to receive an OTP):
#   node backend/truecaller_cli/node_modules/.bin/truecallerjs login
#   node backend/truecaller_cli/node_modules/.bin/truecallerjs -i
TRUECALLER_INSTALLATION_ID=
