# Copy this file to `.env` and fill in your real keys.
# .env is gitignored — these never get committed or sent to the browser.
# The backend uses them for every visitor, so nobody else needs their own key.
# Alice AI doesn't need a key here — it's a self-contained rule engine.

SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
STEAM_API_KEY=
OATHNET_API_KEY=
# Get this by logging into playstation.com then visiting
# https://ca.account.sony.com/api/v1/ssocookie — copy the "npsso" value.
# Expires after ~2 months, just repeat the steps to get a new one.
PSN_NPSSO=
# Free key from fortnite-api.com/dashboard — only needed for /v2/stats
# (their news/cosmetics endpoints are keyless, stats requires one).
FORTNITE_API_KEY=
# TikTok needs no key — it scrapes the profile page's own embedded JSON.
# Free key from numverify.com/product (apilayer) — free tier is http:// only.
NUMVERIFY_API_KEY=
